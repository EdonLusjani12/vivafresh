
# =============================
# PROTECT SENSITIVE FILES
# =============================
<FilesMatch "(db_config\.php|config\.php|\.env|\.sqlite)">
    Require all denied
</FilesMatch>

DirectoryIndex index.php index.html

# Enable rewrite engine
RewriteEngine On

# -----------------------------
# 1. The pages are PHP now; send old .html links to the new pages
RewriteCond %{THE_REQUEST} \s/index\.(html|php)[\s?] [NC]
RewriteRule ^index\.(html|php)$ / [R=301,L]
RewriteRule ^(katalog|cenovnik|kontakt|vrabotuvanje)\.html$ /$1.php [R=301,L]

# -----------------------------
# 2. Clean URLs (/kontakt -> kontakt.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^./]+)/?$ $1.php [L]

# -----------------------------
# 4. Block hotlinking (optional)
# Block fake bots
RewriteCond %{HTTP_USER_AGENT} (python|curl|scrapy|axios|node|go-http-client|java|wget) [NC]
RewriteRule .* - [F,L]

# Block referer abuse
RewriteCond %{HTTP_REFERER} (najdicena\.mk|shop\.mk|price|scrape) [NC]
RewriteRule .* - [F,L]

# -----------------------------
# 5. PHP handler (if needed)
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
